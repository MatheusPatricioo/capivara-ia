[node name="ComputerScreen" type="CanvasLayer"]
layer = 10
script = ExtResource("1_computer_screen")

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.6)

[node name="Monitor" type="PanelContainer" parent="."]
anchors_preset = 15
anchor_left = 0.1
anchor_top = 0.08
anchor_right = 0.9
anchor_bottom = 0.92
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_retro_terminal")

[node name="Layout" type="VBoxContainer" parent="Monitor"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="TitleBar" type="HBoxContainer" parent="Monitor/Layout"]
layout_mode = 2

[node name="Title" type="Label" parent="Monitor/Layout/TitleBar"]
layout_mode = 2
size_flags_horizontal = 3
text = "CAPIVARA-OS v1.0  >_"

[node name="CloseButton" type="Button" parent="Monitor/Layout/TitleBar"]
unique_name_in_owner = true
layout_mode = 2
text = "[X]"

[node name="Tabs" type="TabContainer" parent="Monitor/Layout"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
current_tab = 0

[node name="HistoryTab" type="MarginContainer" parent="Monitor/Layout/Tabs"]
unique_name_in_owner = true
layout_mode = 2
script = ExtResource("2_history_tab")
metadata/_tab_index = 0

[node name="Scroll" type="ScrollContainer" parent="Monitor/Layout/Tabs/HistoryTab"]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="EntryList" type="VBoxContainer" parent="Monitor/Layout/Tabs/HistoryTab/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 14

[node name="DiscoveriesTab" type="MarginContainer" parent="Monitor/Layout/Tabs"]
unique_name_in_owner = true
visible = false
layout_mode = 2
script = ExtResource("3_discoveries_tab")
metadata/_tab_index = 1

[node name="Split" type="HSplitContainer" parent="Monitor/Layout/Tabs/DiscoveriesTab"]
layout_mode = 2
split_offset = 300

[node name="NoteList" type="ItemList" parent="Monitor/Layout/Tabs/DiscoveriesTab/Split"]
unique_name_in_owner = true
custom_minimum_size = Vector2(220, 0)
layout_mode = 2

[node name="NoteText" type="RichTextLabel" parent="Monitor/Layout/Tabs/DiscoveriesTab/Split"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
bbcode_enabled = true
selection_enabled = true

[node name="DrawingsTab" type="MarginContainer" parent="Monitor/Layout/Tabs"]
visible = false
layout_mode = 2
metadata/_tab_index = 2

[node name="Placeholder" type="Label" parent="Monitor/Layout/Tabs/DrawingsTab"]
layout_mode = 2
text = "> carregando desenhos..."

[node name="FolderLabel" type="Label" parent="Monitor/Layout"]
unique_name_in_owner = true
layout_mode = 2
text = "Pasta: -"
text_overrun_behavior = 3
