[node name="Monitor" type="PanelContainer" parent="."]
anchors_preset = 15
anchor_left = 0.1
anchor_top = 0.08
anchor_right = 0.9
anchor_bottom = 0.92
grow_horizontal = 2
grow_vertical = 2
