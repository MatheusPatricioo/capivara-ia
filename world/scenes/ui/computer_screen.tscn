[sub_resource type="Theme" id="Theme_retro_terminal"]
default_font = SubResource("SystemFont_terminal")
default_font_size = 18
Button/colors/font_color = Color(0.2, 0.9, 0.35, 1)
Button/colors/font_hover_color = Color(0.6, 1, 0.65, 1)
Button/colors/font_pressed_color = Color(0.6, 1, 0.65, 1)
