OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120

# Generation options sent to Ollama on every request.
# Max tokens in one reply (~300 tokens = a short paragraph). Longer replies are cut off.
OLLAMA_NUM_PREDICT=300
# Randomness: 0 = always the most likely word, ~0.8 = lively, above 1.2 = rambling.
OLLAMA_TEMPERATURE=0.8
# Penalty for repeating recent words: 1.0 = none, 1.1 = mild, above 1.3 = odd wording.
OLLAMA_REPEAT_PENALTY=1.1

# Embedding model (turns text into vectors) used to pick the chalkboard doodle.
# Install it once with: ollama pull nomic-embed-text
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# How many model replies a single turn may use before giving up (tool calling loop).
MAX_TOOL_STEPS=5

# Search backend used by the ddgs library. "duckduckgo" by default; switch to "auto"
# (several engines) if DuckDuckGo starts blocking automated requests.
WEB_SEARCH_BACKEND=duckduckgo
# Region of the search results: br-pt brings Brazilian pages first
WEB_SEARCH_REGION=br-pt

# Folder where the capybara saves its discoveries (texts, drawings, notes).
# Defaults to discoveries/ in the project root when not set.
# DISCOVERIES_DIR=D:\capivara-descobertas

# How many drawings stay on the chalkboard. A new drawing erases the oldest one;
# the PNG files are kept in the discoveries folder.
CHALKBOARD_CAPACITY=3

# WebSocket server the Godot world connects to (ws://host:port).
# 127.0.0.1 instead of localhost avoids a slow IPv6 attempt on Windows.
WORLD_SERVER_HOST=127.0.0.1
WORLD_SERVER_PORT=8765

# Autonomous mode (python -m src.live_capybara): seconds between two "what do I want to do?"
# moments, and the most tokens (read + written) the capybara may spend in any hour.
# One cycle with a search usually costs a few thousand tokens.
AUTONOMOUS_CYCLE_INTERVAL_SECONDS=120

# Attention: things she notices while walking in the world wait in a short list.
# How many can wait at once (the oldest is forgotten), and how many minutes a thing
# rests after she thought about it before it can catch her eye again.
ATTENTION_CAPACITY=5
ATTENTION_REST_MINUTES=30
MAX_TOKENS_PER_HOUR=60000
# How many of the latest saved discoveries are listed at the start of each cycle, so the
# capybara does not research the same thing again. Each one costs ~15 tokens per step.
MAX_REMEMBERED_DISCOVERIES=20

# Long-term memory: PostgreSQL + pgvector, started with
#   docker compose --env-file brain/.env up -d
# compose.yaml reads these same variables. Choose your own password.
MEMORY_DB_HOST=127.0.0.1
MEMORY_DB_PORT=5432
MEMORY_DB_NAME=capybara_memory
MEMORY_DB_USER=capybara
MEMORY_DB_PASSWORD=change-me
# Seconds a memory call waits for the database. When it is offline, discoveries are still
# saved as Markdown; only remembering them is skipped (and logged).
MEMORY_DB_TIMEOUT_SECONDS=5
# RAG pipeline for the things she noticed, measured step by step with
#   python -m src.run_evals --suite retrieval
# (see brain/evals/reports/). Changing MEMORY_TASK_PREFIXES changes every embedding: run
#   python -m src.load_discoveries_into_memory
# afterwards, so the saved discoveries are embedded again the same way.
# Search: "hybrid" (chunks by meaning + words, fused with RRF) or "vector" (whole text only).
MEMORY_SEARCH_MODE=hybrid
# nomic-embed-text task prefixes ("search_document: " / "search_query: ").
MEMORY_TASK_PREFIXES=true
# Rewrite what she noticed into a search with the subject's real names (one more LLM call).
# Off by default: with rerank on, the decisions were just as right without it (97%).
MEMORY_QUERY_REWRITING=false
# Rerank: the LLM picks, among the closest discoveries, the one really about the subject.
MEMORY_RERANK=true
# Discoveries below this similarity are not offered to the rerank (nor returned by the
# recall_memory tool). With the task prefixes, similarities are lower than without them:
# 0.70 cut right answers out (70% right decisions), 0.50 kept them (97%).
MEMORY_RECALL_MIN_SIMILARITY=0.50
# Agentic RAG: offer her the recall_memory tool, so she decides when to search her treasure.
# Off by default: qwen2.5:7b never called it in the evals, and having one more tool made it
# save fewer discoveries. Worth turning on with a bigger model (and measuring again).
MEMORY_RECALL_TOOL=false

# Suggestions for her world: a new request is refused as a repeat when its similarity to
# an earlier one reaches this value, from 0 to 1. Measured with nomic-embed-text: different
# wishes reached 0.73, the same wish with the same key words scored 0.80 to 0.90 (reworded
# ones, like "luneta" and "telescópio", stay below and get through). Kept high on purpose:
# refusing a new wish is worse than letting a reworded one through.
# Every comparison is in the log ("Closest earlier suggestion to ...").
SUGGESTION_REPEAT_MIN_SIMILARITY=0.80

# Brain log file (tool calls, step counts). Nothing here shows up in the chat.
# Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL. INFO records every tool call.
LOG_LEVEL=INFO
# LOG_FILE=D:\corvo-ia\logs\capybara.log
